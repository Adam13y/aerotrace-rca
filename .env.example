ANTHROPIC_API_KEY=your_claude_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
DATA_DIR=./data
REPORT_DIR=./data/reports
LOG_LEVEL=INFO

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# OLLAMA_TIMEOUT=120
# OLLAMA_NUM_CTX=10240          # context window; must fit the hypothesis prompt (~7k tokens with RAG)
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_REPRODUCIBLE=true       # identical output for identical input; false = faster (KV cache reuse)
# CLAUDE_MAX_TOKENS=4096
